---
import "@/styles/global.css";
import Head from "@/components/Head.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

type Props = import("astro/types").ComponentProps<typeof Head>;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <Head {...Astro.props} />
  </head>
  <body>
    <div
      class="grid grid-cols-[minmax(0,1fr)] grid-rows-[auto_1fr_auto] max-w-frame min-h-[calc(100svh-2*var(--inset))] mx-auto border border-ink"
    >
      <Header />
      <main class="flex flex-col" transition:animate="fade">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

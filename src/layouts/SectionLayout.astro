---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import { siteName } from "@/lib/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<BaseLayout title={`${title} | ${siteName}`} description={description}>
  <div class:list={{ split: hasAside }}>
    <section class="page">
      <h1>{title}</h1>
      {
        Astro.slots.has("default") ? (
          <div class="body">
            <Prose>
              <slot />
            </Prose>
          </div>
        ) : null
      }
    </section>
    {
      hasAside ? (
        <div class="aside">
          <slot name="aside" />
        </div>
      ) : null
    }
  </div>
  <slot name="after" />
</BaseLayout>

<style>
  .page {
    padding: 3rem var(--gap);
  }

  h1 {
    margin: 0;
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .body {
    margin-top: 2rem;
  }

  /* With an aside: the text keeps its measure on the left, the aside takes the rest. */
  .split {
    display: flex;
    flex: 1;
  }

  .split .page {
    flex: 0 1 calc(var(--measure) + 2 * var(--gap));
    min-width: 0;
  }

  .aside {
    position: relative;
    flex: 1;
    margin: var(--gap) var(--gap) var(--gap) 0;
    border: var(--rule);
  }

  @media (max-width: 44rem) {
    .split {
      display: block;
    }

    .aside {
      aspect-ratio: 2;
      margin: 0 var(--gap) var(--gap);
    }
  }
</style>

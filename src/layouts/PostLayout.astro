---
import "katex/dist/katex.min.css";
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import { isHidden, isoDate, longDate, type Post } from "@/lib/posts";
import { siteName } from "@/lib/site";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, recentDate, author } = post.data;
const { Content } = await render(post);
const hidden = isHidden(post);
const updated = recentDate && isoDate(recentDate) !== isoDate(pubDate) ? recentDate : undefined;
---

<BaseLayout title={`${title} | ${siteName}`} description={description} published={pubDate} noindex={hidden}>
  <article class="py-12 px-(--gap)">
    <p class="label flex flex-wrap gap-x-2 mb-6">
      <a href="/posts">Posts</a>
      <span aria-hidden="true">/</span>
      <time datetime={isoDate(pubDate)}>{longDate(pubDate)}</time>
      {
        updated ? (
          <span>
            · Updated <time datetime={isoDate(updated)}>{longDate(updated)}</time>
          </span>
        ) : null
      }
      {hidden ? <span class="px-2 text-paper bg-ink">Draft: not on the built site</span> : null}
    </p>
    <h1 class="text-h1 font-heading leading-none tracking-[-0.03em] text-balance">{title}</h1>
    <p class="mt-4 mb-8 text-muted">{author}</p>
    <Prose>
      <Content />
    </Prose>
  </article>
</BaseLayout>

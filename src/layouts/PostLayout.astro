---
import "katex/dist/katex.min.css";
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import { isHidden, isoDate, longDate, type Post } from "@/lib/posts";
import { siteName } from "@/lib/site";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, recentDate, author } = post.data;
const { Content } = await render(post);
const hidden = isHidden(post);
const updated = recentDate && isoDate(recentDate) !== isoDate(pubDate) ? recentDate : undefined;
---

<BaseLayout title={`${title} | ${siteName}`} description={description} published={pubDate} noindex={hidden}>
  <article>
    <p class="meta label">
      <a href="/posts">Posts</a>
      <span aria-hidden="true">/</span>
      <time datetime={isoDate(pubDate)}>{longDate(pubDate)}</time>
      {
        updated ? (
          <span>
            · Updated <time datetime={isoDate(updated)}>{longDate(updated)}</time>
          </span>
        ) : null
      }
      {hidden ? <span class="draft">Draft: not on the built site</span> : null}
    </p>
    <h1>{title}</h1>
    <p class="byline">{author}</p>
    <Prose>
      <Content />
    </Prose>
  </article>
</BaseLayout>

<style>
  article {
    padding: 3rem var(--gap);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0 0 1.5rem;
  }

  .draft {
    padding: 0 0.5rem;
    color: var(--paper);
    background: var(--ink);
  }

  h1 {
    margin: 0;
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .byline {
    margin: 1rem 0 2rem;
    color: var(--muted);
  }
</style>

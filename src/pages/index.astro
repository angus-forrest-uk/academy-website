---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Band from "@/components/Band.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/Card.astro";
import Cards from "@/components/Cards.astro";
import NoisePortrait from "@/components/NoisePortrait.astro";
import { sections, siteName } from "@/lib/site";
import { longDate, publishedPosts } from "@/lib/posts";
import { dayMonthAndYear } from "@/lib/dates";
import { publications } from "@/lib/publications";

interface Preview {
  kind: string;
  title: string;
  text?: string;
  href: string;
}

// In place of a picture, a section can show what is newest on its page.
const previews: Record<string, Preview[]> = {
  "/posts": (await publishedPosts()).slice(0, 3).map((post) => ({
    kind: `Post · ${longDate(post.data.pubDate)}`,
    title: post.data.title,
    href: `/posts/${post.id}`,
  })),
  "/research": publications.slice(0, 3).map((publication) => ({
    kind: `Publication · ${dayMonthAndYear(publication.date)}`,
    title: publication.title,
    text: publication.venue,
    href: `/research#${publication.bibcode}`,
  })),
};
---

<BaseLayout title={siteName}>
  <section class="relative flex flex-1 items-end min-h-[40svh] p-(--gap)">
    <NoisePortrait index={40} hues={[225, 355]} frequency={0.003} />
    <h1 class="relative text-hero font-heading leading-none tracking-[-0.03em]">{siteName}</h1>
  </section>
  {
    sections.map(({ href, label, summary }, index) => {
      const items = previews[href] ?? [];
      return (
        <Band href={href} label={label} summary={summary} flipped={index % 2 === 1} framed={items.length === 0}>
          <Button slot="button" href={href} aria-label={`Go to ${label}`}>
            Learn more
          </Button>
          {items.length > 0 ? (
            <Cards fill>
              {items.map((item) => (
                <Card {...item} />
              ))}
            </Cards>
          ) : (
            <NoisePortrait index={120 + index} frequency={0.003} />
          )}
        </Band>
      );
    })
  }
</BaseLayout>


---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NoisePortrait from "@/components/NoisePortrait.astro";
import { sections, siteName } from "@/lib/site";
import { isoDate, longDate, publishedPosts } from "@/lib/posts";
import { dayMonthAndYear } from "@/lib/dates";
import { publications } from "@/lib/publications";

interface Preview {
  kind: string;
  when: string;
  datetime: string;
  title: string;
  source?: string;
  href: string;
}

const previews: Record<string, Preview[]> = {
  "/posts": (await publishedPosts()).slice(0, 3).map((post) => ({
    kind: "Post",
    when: longDate(post.data.pubDate),
    datetime: isoDate(post.data.pubDate),
    title: post.data.title,
    href: `/posts/${post.id}`,
  })),
  "/research": publications.slice(0, 3).map((publication) => ({
    kind: "Publication",
    when: dayMonthAndYear(publication.date),
    datetime: publication.date,
    title: publication.title,
    source: publication.venue,
    href: `/research#${publication.bibcode}`,
  })),
};
---

<BaseLayout title={siteName}>
  <section class="banner">
    <NoisePortrait index={40} hues={[225, 355]} frequency={0.003} />
    <h1 class="banner-title">{siteName}</h1>
  </section>
  {
    sections.map(({ href, label, summary }, index) => (
      <section class:list={["page-split", "page-band", { "page-split-flipped": index % 2 === 1 }]}>
        <div class="page">
          <div class="page-body">
            <h2>
              <a href={href}>{label}</a>
            </h2>
            <p>{summary}</p>
            <a class="button" href={href} aria-label={`Go to ${label}`}>
              Learn more
            </a>
          </div>
        </div>
        {previews[href]?.length ? (
          <ul class="page-aside updates">
            {previews[href].map(({ kind, when, datetime, title, source, href: where }) => (
              <li>
                <a class="chip update" href={where}>
                  <span class="paper-reference">
                    {kind} · <time datetime={datetime}>{when}</time>
                  </span>
                  <span class="paper-title">{title}</span>
                  {source ? <span class="update-source">{source}</span> : null}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <a class="page-aside" href={href} aria-label={label} tabindex="-1">
            <NoisePortrait index={120 + index} frequency={0.003} />
          </a>
        )}
      </section>
    ))
  }
</BaseLayout>

---
import SectionLayout from "@/layouts/SectionLayout.astro";
import { linkGroups } from "@/lib/links";
---

<SectionLayout title="Links" description="Talks, code, data and other places this work lives.">
  <p>Talks, code, data and other places my work lives off this site. Edit them in <code>src/content/links.yaml</code>.</p>
  <Fragment slot="after">
    {
      linkGroups.map(({ group, links }) => (
        <section class="group">
          <h2 class="group-label">{group}</h2>
          <ul class="papers">
            {links.map(({ title, url, kind, note }) => (
              <li class="chip paper post-chip">
                <a class="paper-text" href={url} rel="noopener">
                  <p class="paper-reference">{kind}</p>
                  <h3 class="paper-title">{title}</h3>
                  {note ? <p class="post-description">{note}</p> : null}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </Fragment>
</SectionLayout>

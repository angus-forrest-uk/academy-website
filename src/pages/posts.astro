---
import SectionLayout from "@/layouts/SectionLayout.astro";
import Card from "@/components/Card.astro";
import Cards from "@/components/Cards.astro";
import Group from "@/components/Group.astro";
import { isHidden, longDate, publishedPosts } from "@/lib/posts";

const posts = await publishedPosts();
---

<SectionLayout title="Posts" description="Writing: notes on papers, talks and methods.">
  <p>Longer writing, newest first. Also available as an <a href="/feed.xml">RSS feed</a>.</p>
  <Group label="All posts" id="all-posts" slot="after">
    {
      posts.length === 0 ? (
        <p>Nothing published yet.</p>
      ) : (
        <Cards>
          {posts.map((post) => (
            <Card
              kind={`${longDate(post.data.pubDate)}${isHidden(post) ? " · Draft" : ""}`}
              title={post.data.title}
              text={post.data.description}
              href={`/posts/${post.id}`}
            />
          ))}
        </Cards>
      )
    }
  </Group>
</SectionLayout>

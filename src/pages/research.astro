---
import SectionLayout from "@/layouts/SectionLayout.astro";
import Cards from "@/components/Cards.astro";
import Group from "@/components/Group.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import { Content as Intro } from "@/content/research.md";
import { publications } from "@/lib/publications";
---

<SectionLayout title="Research">
  <Intro />
  <Group label="Publications" id="publications" slot="after">
    <Cards>
      {publications.map((publication, index) => <PublicationCard publication={publication} index={index} />)}
    </Cards>
  </Group>
</SectionLayout>

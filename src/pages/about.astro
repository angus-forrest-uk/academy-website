---
import SectionLayout from "@/layouts/SectionLayout.astro";
import NoisePortrait from "@/components/NoisePortrait.astro";
import Icon from "@/components/Icon.astro";
import { Content } from "@/content/about.md";
import { email, profiles } from "@/lib/site";
---

<SectionLayout title="About">
  <Content />
  {/* Swap the noise for a photo of yourself by putting one in public/images
      and replacing this line with <img src="/images/you.jpg" alt="" class="portrait" />. */}
  <NoisePortrait slot="aside" index={60} hues={[140, 325]} frequency={0.003} />
  <section class="group" id="contact" slot="after">
    <h2 class="group-label">Contact</h2>
    <ul class="people">
      <li class="chip">
        <span class="chip-name">Email</span>
        <span class="chip-detail"><a href={`mailto:${email}`}>{email}</a></span>
      </li>
      {
        profiles.map(({ label, href, icon }) => (
          <li class="chip">
            <span class="chip-name">{label}</span>
            <span class="chip-links">
              <a href={href} rel="noopener me">
                <Icon name={icon} title={`Me on ${label}`} />
              </a>
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</SectionLayout>

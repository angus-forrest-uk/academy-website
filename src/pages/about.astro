---
import SectionLayout from "@/layouts/SectionLayout.astro";
import Card from "@/components/Card.astro";
import Cards from "@/components/Cards.astro";
import Group from "@/components/Group.astro";
import NoisePortrait from "@/components/NoisePortrait.astro";
import { Content } from "@/content/about.md";
import { email, profiles } from "@/lib/site";
---

<SectionLayout title="About">
  <Content />
  {/* To use a photo instead, put it in public/ and replace this line with
      <img slot="aside" src="/you.jpg" alt="" style="width:100%;height:100%;object-fit:cover" /> */}
  <NoisePortrait slot="aside" index={60} hues={[140, 325]} frequency={0.003} />
  <Group label="Contact" id="contact" slot="after">
    <Cards layout="grid">
      <Card kind="Email" title={email} href={`mailto:${email}`} />
      {profiles.map(({ label, href }) => <Card kind="Profile" title={label} href={href} />)}
    </Cards>
  </Group>
</SectionLayout>

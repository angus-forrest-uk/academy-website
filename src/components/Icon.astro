export type IconName = keyof typeof icons;

interface Props extends Omit<HTMLAttributes<"svg">, "viewBox"> {
  name: IconName;
  /** Accessible name. Omit for decorative icons next to a text label. */
  title?: string;
}

const { name, title, class: className, ...rest } = Astro.props;
const icon: { viewBox?: string; body: string } = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={icon.viewBox ?? "0 0 24 24"}
  class:list={["icon", className]}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  {...rest}
>
  {title && <title>{title}</title>}
  <Fragment set:html={icon.body} />
</svg>

---
interface Props {
  /** "rows": one card to a row. "grid": small cards side by side. */
  layout?: "rows" | "grid";
  /** Stretches the cards to share the height of the box they are in. */
  fill?: boolean;
}

const { layout = "rows", fill = false } = Astro.props;
---

<ul
  class:list={[
    "grid gap-(--gap)",
    { "grid-cols-[repeat(auto-fill,minmax(min(var(--width-card),100%),var(--width-card)))]": layout === "grid" },
    { "h-full auto-rows-fr": fill },
  ]}
><slot /></ul>

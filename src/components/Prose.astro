---
// Wraps text written in markdown. Markdown's HTML isn't part of this
// component's own markup, so its styles reach in with :global().
---

<div class="prose"><slot /></div>

<style>
  .prose {
    max-width: var(--measure);
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin: 0;
  }

  .prose :global(p + p) {
    margin-top: 1em;
  }

  .prose :global(:is(h2, h3)) {
    margin: 3rem 0 1rem;
    font-size: var(--text-md);
    font-weight: var(--weight-heading);
    line-height: 1.2;
    scroll-margin-top: 2rem;
  }

  .prose :global(:is(ul, ol)) {
    margin: 1em 0;
    padding-left: 1.5rem;
  }

  .prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--ink);
  }

  .prose :global(code) {
    padding: 0.1em 0.3em;
    font-size: 0.9em;
    background: var(--wash);
    overflow-wrap: anywhere;
  }

  .prose :global(pre) {
    margin: 1.5rem 0;
    padding: 1rem;
    border: var(--rule);
    background: var(--wash) !important;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  /* Shiki writes the light colours inline and the dark ones as variables. */
  @media (prefers-color-scheme: dark) {
    .prose :global(:is(pre, pre span[style])) {
      color: var(--shiki-dark) !important;
    }
  }

  .prose :global(img) {
    display: block;
    border: var(--rule);
  }

  .prose :global(figure) {
    margin: 1.5rem 0;
  }

  .prose :global(figcaption) {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .prose :global(.katex-display) {
    margin: 1.5rem 0;
    overflow-x: auto;
    overflow-y: hidden;
  }

  /* rehype-table-scroll wraps each table so it scrolls on a narrow screen. */
  .prose :global(.content-table) {
    margin: 1.5rem 0;
    overflow-x: auto;
    border: var(--rule);
  }

  .prose :global(table) {
    width: 100%;
    min-width: 24rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .prose :global(:is(th, td)) {
    padding: 0.5rem 0.75rem;
    border-bottom: var(--rule);
    vertical-align: top;
  }

  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>

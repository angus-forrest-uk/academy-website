---
// Wraps text written in markdown. Markdown's HTML isn't part of this
// component's own markup, so its styles reach in with :global(). Utilities
// are applied from the global Tailwind stylesheet via @reference.
---

<div class="prose max-w-measure"><slot /></div>

<style>
  @reference "../styles/global.css";

  .prose > :global(:first-child) {
    @apply mt-0;
  }

  .prose :global(p + p) {
    @apply mt-[1em];
  }

  .prose :global(:is(h2, h3)) {
    @apply mt-12 mb-4 text-md font-heading leading-[1.2] scroll-mt-8;
  }

  .prose :global(:is(ul, ol)) {
    @apply my-[1em] pl-6;
  }

  .prose :global(li + li) {
    @apply mt-2;
  }

  .prose :global(blockquote) {
    @apply my-6 pl-4 border-l-[3px] border-l-ink;
  }

  .prose :global(code) {
    @apply py-[0.1em] px-[0.3em] text-[0.9em] bg-wash [overflow-wrap:anywhere];
  }

  .prose :global(pre) {
    @apply my-6 p-4 border border-ink bg-wash! whitespace-pre-wrap [overflow-wrap:anywhere];
  }

  .prose :global(pre code) {
    @apply p-0 bg-none;
  }

  /* Shiki writes the light colours inline and the dark ones as variables. */
  @media (prefers-color-scheme: dark) {
    .prose :global(:is(pre, pre span[style])) {
      color: var(--shiki-dark) !important;
    }
  }

  .prose :global(img) {
    @apply block border border-ink;
  }

  .prose :global(figure) {
    @apply my-6;
  }

  .prose :global(figcaption) {
    @apply mt-2 text-muted text-sm;
  }

  .prose :global(.katex-display) {
    @apply my-6 [overflow-x:auto] [overflow-y:hidden];
  }

  /* rehype-table-scroll wraps each table so it scrolls on a narrow screen. */
  .prose :global(.content-table) {
    @apply my-6 [overflow-x:auto] border border-ink;
  }

  .prose :global(table) {
    @apply w-full min-w-96 border-collapse text-sm text-left;
  }

  .prose :global(:is(th, td)) {
    @apply py-2 px-3 border-b border-ink align-top;
  }

  .prose :global(tr:last-child td) {
    @apply border-b-0;
  }

  .prose :global(th) {
    @apply font-mono text-xs font-medium tracking-[0.06em] uppercase;
  }
</style>

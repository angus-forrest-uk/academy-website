---
import { siteName } from "@/lib/site";
---

<footer class="label">
  <span>{siteName} · {new Date().getFullYear()}</span>
  <a href="/feed.xml">RSS</a>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem var(--gap);
    border-top: var(--rule);
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>

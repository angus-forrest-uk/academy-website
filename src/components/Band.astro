---
interface Props {
  href: string;
  label: string;
  summary: string;
  /** Puts the aside on the left instead of the right. */
  flipped?: boolean;
  /** Draws a ruled box around the aside, as for a picture. */
  framed?: boolean;
}

const { href, label, summary, flipped = false, framed = true } = Astro.props;
const asideMargin = flipped ? "mr-0 ml-(--gap)" : "ml-0 mr-(--gap)";
---

<section class:list={["flex border-t border-ink max-[44rem]:block", { "flex-row-reverse": flipped }]}>
  <div class="grow-0 shrink basis-[calc(var(--measure)+2*var(--gap))] self-center min-w-0 py-12 px-(--gap)">
    <h2 class="mb-4 text-md font-heading"><a href={href}>{label}</a></h2>
    <p>{summary}</p>
    <slot name="button" />
  </div>
  <div
    class:list={[
      "relative flex-1 min-h-96 my-(--gap)",
      asideMargin,
      "max-[44rem]:min-h-0 max-[44rem]:mt-0 max-[44rem]:mx-(--gap)",
      { "border border-ink max-[44rem]:aspect-[3/2]": framed },
    ]}
  >
    <slot />
  </div>
</section>

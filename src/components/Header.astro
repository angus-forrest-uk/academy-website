---
import { pagePath, sectionOf, sections, siteName } from "@/lib/site";

const path = pagePath(Astro.url.pathname);
const current = sectionOf(path)?.href;
---

<header class="frame-header">
  <a class="frame-name" href="/" aria-current={path === "/" ? "page" : undefined}>{siteName}</a>
  <nav class="frame-nav" aria-label="Sections">
    {
      sections.map(({ href, label, parts }) => (
        <div class="frame-nav-item">
          <a href={href} aria-current={current === href ? "page" : undefined}>
            {label}
          </a>
          {parts.length > 0 ? (
            <ul class="frame-submenu">
              {parts.map((part) => (
                <li>
                  <a href={`${href}#${part.id}`}>{part.label}</a>
                </li>
              ))}
            </ul>
          ) : null}
        </div>
      ))
    }
  </nav>
</header>

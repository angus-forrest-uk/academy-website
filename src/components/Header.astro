---
import { pagePath, sectionOf, sections, siteName } from "@/lib/site";

const path = pagePath(Astro.url.pathname);
const current = sectionOf(path)?.href;

const link =
  "py-3 px-(--gap) hover:text-paper hover:bg-ink [&[aria-current=page]]:text-paper [&[aria-current=page]]:bg-ink max-[44rem]:px-2 max-[44rem]:text-center";
---

<header class="label flex flex-wrap justify-between border-b border-ink">
  <a href="/" class={link} aria-current={path === "/" ? "page" : undefined}>{siteName}</a>
  <nav class="flex flex-wrap max-[44rem]:grid max-[44rem]:grid-cols-3 max-[44rem]:w-full max-[44rem]:border-t max-[44rem]:border-ink" aria-label="Sections">
    {
      sections.map(({ href, label }) => (
        <a href={href} class={`${link} border-l border-ink max-[44rem]:[&:nth-child(3n+1)]:border-l-0 max-[44rem]:[&:nth-child(n+4)]:border-t max-[44rem]:[&:nth-child(n+4)]:border-ink`} aria-current={current === href ? "page" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</header>

---
interface Props {
  title: string;
  /** The small line above the title: a date, a journal, a kind of link. */
  kind?: string;
  /** A sentence under the title. */
  text?: string;
  /** Makes the whole card a link. */
  href?: string;
  /** For linking straight to the card, as in /research#2025ApJ...988..121F. */
  id?: string;
}

const { title, kind, text, href, id } = Astro.props;
const Tag = href ? "a" : "div";
const external = href?.startsWith("http");
const hasImage = Astro.slots.has("image");
---

<li
  id={id}
  class:list={[
    "flex border border-ink scroll-mt-(--gap) [&:target]:outline-3 [&:target]:outline-ink [&:target]:outline-offset-3",
    { "max-[44rem]:flex-col-reverse": hasImage },
  ]}
>
  <Tag
    class:list={[
      "flex flex-1 flex-col justify-center gap-3 min-w-0 p-(--gap) [&>*]:max-w-(--measure-wide)",
      { "hover:text-paper hover:bg-ink": href },
    ]}
    href={href}
    rel={external ? "noopener" : undefined}
  >
    {kind ? <p class="label">{kind}</p> : null}
    <h3 class="text-md font-heading leading-[1.2] text-balance">{title}</h3>
    {text ? <p class="text-sm">{text}</p> : null}
    <slot />
  </Tag>
  {
    hasImage ? (
      <div class="relative w-(--width-card) border-l border-ink max-[44rem]:w-full max-[44rem]:aspect-2/1 max-[44rem]:border-l-0 max-[44rem]:border-b border-ink">
        <slot name="image" />
      </div>
    ) : null
  }
</li>
